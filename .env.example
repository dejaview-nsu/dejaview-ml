ML_QDRANT_URL=http://localhost:6333
ML_QDRANT_GRPC_PORT=6334
ML_QDRANT_PREFER_GRPC=true
ML_QDRANT_TIMEOUT_SECONDS=2
# ML_QDRANT_API_KEY=
ML_CACHE_DIR=.cache/huggingface
ML_LOCAL_FILES_ONLY=false
ML_DEVICE=cpu
ML_IMAGE_ENABLED=true
ML_VIDEO_ENABLED=true
ML_TEXT_ENABLED=true
ML_AUDIO_ENABLED=true
ML_TOP_K=20
# Порог релевантности по модальностям, none - выключен. Общий ML_SCORE_THRESHOLD - для модальностей без своего.
# ML_SCORE_THRESHOLD=none
# ML_SCORE_THRESHOLD_TEXT=none
# ML_SCORE_THRESHOLD_IMAGE=0.8614
# ML_SCORE_THRESHOLD_VIDEO=0.9743
# ML_SCORE_THRESHOLD_AUDIO=0.8297
ML_FFMPEG_TIMEOUT_SECONDS=10
ML_BODY_READ_TIMEOUT_SECONDS=30
ML_TORCH_THREADS=4
# Changing revisions requires reindexing the corresponding collection.
ML_IMAGE_REVISION=3d74acf9a28c67741b2f4f2ea7635f0aaf6f0268
ML_VIDEO_REVISION=d2f89850fec28ac1e5cd27db2f0b76d7491e61ce
ML_TEXT_REVISION=d128750597153bb5987e10b1c3493a34e5a4502a
ML_AUDIO_REVISION=365dea6ef167def6676140ed93bbc43f84dabb28
