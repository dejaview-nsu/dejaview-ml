# Скопируйте в scripts/index/.env и заполните.

# Ключ TMDB, тот же, что у скрипта каталога. Нужен один из двух.
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=

# PostgreSQL с таблицей movies. Через SSH-туннель - адрес локального конца туннеля.
# 127.0.0.1, а не localhost: под Windows localhost сначала идёт на IPv6 и ждёт таймаута.
DATABASE_URL=postgresql://dejaview:password@127.0.0.1:5432/dejaview

# Qdrant и модели: те же переменные ML_*, что у ML-сервиса. Ревизии весов не меняйте:
# векторы индекса должны совпадать с векторами запросов.
ML_QDRANT_URL=http://127.0.0.1:6333
# Ключ Qdrant: на dev-сервере обязателен, локальному Qdrant без авторизации не нужен.
# ML_QDRANT_API_KEY=
# ML_QDRANT_GRPC_PORT=6334
# ML_QDRANT_PREFER_GRPC=true
# ML_CACHE_DIR=.cache/huggingface
# ML_LOCAL_FILES_ONLY=false
# ML_DEVICE=auto
# ML_TORCH_THREADS=4

# Необязательные настройки, ниже значения по умолчанию
# INDEX_WORK_DIR=scripts/index/work
# INDEX_QDRANT_TIMEOUT_SECONDS=60
# TMDB_REQUESTS_PER_SECOND=20
