# Скопируйте в scripts/catalog/.env и заполните.

# Ключ TMDB: https://www.themoviedb.org/settings/api
# Нужен один из двух. Предпочтительнее токен доступа (API Read Access Token).
TMDB_ACCESS_TOKEN=
# TMDB_API_KEY=

# Необязательные настройки, ниже значения по умолчанию
# CATALOG_TARGET_SIZE=1000
# CATALOG_MIN_VOTE_COUNT=200
# CATALOG_YEAR_FROM=1950
# TMDB_REQUESTS_PER_SECOND=20
# TMDB_POSTER_SIZE=w500
# CATALOG_OUTPUT_DIR=scripts/catalog/output
# CATALOG_PRIORITY_IDS_FILE=scripts/catalog/priority_ids.txt
